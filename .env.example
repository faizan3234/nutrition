# Local-first vision AI: auto detects installed local models (YOLO -> NutriLens -> CLIP -> none).
# Zero cloud vision / zero Gemini dependency.
VISION_PROVIDER=auto

# Optional Groq API for online packaged nutrition search (e.g. Epigamia, Amul Kool) & Whisper voice
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Local food models paths
NUTRILENS_WEIGHTS=models/nutrilens.h5
NUTRILENS_LABELS=models/nutrilens_labels.json
YOLO_WEIGHTS=models/food_detector.pt
CLIP_MODEL=openai/clip-vit-base-patch32

# SQLite path; do not put your production database in a temporary directory.
NUTRITION_DB_PATH=./nutrition.sqlite3

# Optional licensed and source-labelled nutrition CSV, takes priority over illustrative samples.
AUTHORIZED_FOOD_CSV=

# Set to your deployed Reliv PWA domain(s) only, separated with commas.
# Example CORS_ALLOWED_ORIGINS=https://example.vercel.app
CORS_ALLOWED_ORIGINS=

# Name + valid homepage/contact for Open Food Facts API identification.
OFF_USER_AGENT=RelivNutritionAI/0.6 (https://relivkiosk.vercel.app)

# Production requires existing Reliv auth backend to mint a profile-scoped
# signed JWT. Without a 32+ character secret, private log APIs fail closed.
RELIV_ENV=local
RELIV_AUTH_SECRET=

# USDA FoodData Central (CC0); required only for USDA reference food lookup.
FDC_API_KEY=

# Optional operator-reviewed restaurant nutrition source CSV.
RELIV_RESTAURANT_NUTRITION_CSV=

# Human-reviewed food learning dataset (separate admin portal at /admin).
# Admin endpoints fail closed without a unique random 32+ character token.
RELIV_ADMIN_TOKEN=

# Private directory NOT mounted as public static content; backup securely and encrypt at rest.
RELIV_LEARNING_IMAGE_DIR=./private_learning_images

# Optional local semantic near-food similarity search. Model weights NOT bundled.
RELIV_SEMANTIC_MODEL_DIR=
